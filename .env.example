# Relay configuration
# Copy to .env and fill in what you need. The demo runs with everything left
# as-is: empty secrets keep the carrier on its mock adapter.

# Mode
DEMO_MODE=true
ENV=dev

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://relay:relay@localhost:5542/relay

# Twilio: only needed for live sends
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Anthropic: reply generation upgrades from templates to an LLM when set
ANTHROPIC_API_KEY=
MODEL_REPLY=claude-haiku-4-5-20251001

# Delivery controls
RATE_LIMIT_PER_SECOND=10
QUIET_HOURS_START=21
QUIET_HOURS_END=9
TIMEZONE=Australia/Melbourne

# Hot lead handoff: POSTed a JSON payload when a conversation goes to handoff.
# Leave empty to log instead.
HANDOFF_WEBHOOK_URL=

# Public URL of this app, used for Twilio signature verification
PUBLIC_BASE_URL=http://localhost:8000
